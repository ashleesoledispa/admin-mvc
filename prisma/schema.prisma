generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  date      DateTime
  capacity  Int
  category  String
  createdAt DateTime @default(now())

  sales Sale[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  ticketsSold Int
  price       Float
  createdAt   DateTime @default(now())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])
}